#task-4
# as per my understanding anomalies means if any sale amount is twice more than the average sales price then its anomaly
# i classify the anomaly and normal data using case functions
WITH aveage_sales AS
( 
SELECT Product_Line,
ROUND(AVG(Total), 2) AS avg_sales
FROM walmart_sales
GROUP BY Product_Line
)
SELECT w.Invoice_ID, w.Product_Line,
w.Total AS sales_amount, a.avg_sales,
CASE 
WHEN (w.Total - a.avg_sales) > 2 * a.AVG_SALES THEN 'Anomaly'
ELSE 'Normal'
END AS status
FROM walmart_sales w
JOIN aveage_sales as a
ON w.Product_Line = a.Product_Line
WHERE (w.Total - a.avg_sales) > 2 * a.AVG_SALES ;


