# task-1
# for this task i used a CTE  to break down the query into 3 part 1st part is to calculate total sale, next is to calculate growth of sales and last part is to find the avg. of growth
with Total_sale as
(
 select branch, month(date) as months, 
 sum(total) as sales from walmart_sales
 group by Branch, months
 order by branch
),
growth as
(
 select branch, months, sales,
 lag (sales) over
 (partition by branch order by months) as pre_sales,
 (sales - lag (sales) over (partition by branch order by months) ) *100 / lag (sales) over (partition by branch order by months) as Growth
 from total_sale
)
select branch, round (avg(growth), 2) as avg_growth from growth
group by branch
limit 1;


# task-2
with sales_cost as
(
select branch, Product_line, sum(total) as sales, sum(cogs) as cost from walmart_sales
group by branch, Product_line
order by branch
),
profits as
(
select branch, product_line, 
rank() over 
(partition by branch order by sales desc) as ranks,
(sales - cost) as profit
from sales_cost
)
select branch, product_line, round(profit, 2) as Profit from profits
where ranks = 1;


