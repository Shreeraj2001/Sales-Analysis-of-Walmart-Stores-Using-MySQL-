with prev_sales as
(
select customer_id, date, 
lag (date) over
(partition by customer_id order by date) as Prev_saledate
from walmart_sales
),
sales_difference as
(
select customer_id, date, prev_saledate, 
datediff(date , prev_saledate) as differnce
from prev_sales
)
select distinct customer_id from sales_difference
where differnce <= 30 ;


