with total_payments as
(
select city, payment, count(payment) as no_payments from walmart_sales
group by city, payment
order by city
),
popular_payments as
(
select city, payment, no_payments,
rank() over
(partition by city order by payment) as ranks 
from total_payments
)
select city, payment, no_payments from popular_payments
where ranks = 1;


